# Copy to .env and fill in. Never commit .env.

# Gemini — used by the web orchestrator at /api/investigate for both the
# synthesis path and the ?agent=1 tool-calling loop. Get a key at
# https://aistudio.google.com/app/apikey.
GEMINI_API_KEY=

# Optional: model override (defaults to gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# Geocoding (free for the hackathon; document Mapbox migration in /web/README.md)
NOMINATIM_USER_AGENT="Dryline/0.0.1 (mail@willhin.es)"

# MCP server transport
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8787

# DuckDB snapshot path (relative to repo root)
DRYLINE_DUCKDB_PATH=./mcp/data/dryline.duckdb

# Public Web URLs (set per environment)
NEXT_PUBLIC_MCP_URL=http://localhost:8787
