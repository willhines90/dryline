# Copy to .env and fill in. Never commit .env.

# OpenAI — used by the runtime agent (Responses API + MCP)
OPENAI_API_KEY=

# Geocoding (free for the hackathon; document Mapbox migration in /web/README.md)
NOMINATIM_USER_AGENT="Dryline/0.0.1 (mail@willhin.es)"

# MCP server transport
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8787

# DuckDB snapshot path (relative to repo root)
DRYLINE_DUCKDB_PATH=./mcp/data/dryline.duckdb

# Public Web URLs (set per environment)
NEXT_PUBLIC_MCP_URL=http://localhost:8787
